# =============================================================================
# Development Environment Configuration
# =============================================================================
# Copy to .env and fill in your local values.
# This file is safe to commit — it contains only placeholders.

# --- Application ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

# --- PostgreSQL (local dev) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseexpends
POSTGRES_USER=pulseexpends
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://pulseexpends:CHANGE_ME@localhost:5432/pulseexpends?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication ---
# For dev: either set JWT_SECRET or use RSA keys (recommended)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=7d
JWT_ISSUER=pulseexpends

# --- Statement Encryption (required even in dev) ---
# Generate with: openssl rand -hex 32
STATEMENT_PASSWORD_KEY=

# --- Email (use Ethereal for dev) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pulseexpends.com

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Cookies ---
COOKIE_SECURE=false

# --- Logging ---
LOG_LEVEL=debug
