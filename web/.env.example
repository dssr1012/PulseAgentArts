# =============================================================================
# PulseExpends Web (Next.js) - Environment Configuration Template
# =============================================================================
# Copy to .env.local and fill in your values.

# API URL (use relative path to go through nginx reverse proxy, or set explicit URL)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Server
PORT=3001
HOSTNAME=0.0.0.0

# Google OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
