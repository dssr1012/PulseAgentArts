# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy to .env and fill in PRODUCTION values.
# NEVER commit this file with real values — .env is gitignored.
# Generate secrets with: openssl rand -hex 32

# --- Application ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
FRONTEND_URL=https://your-domain.com

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseexpends
POSTGRES_USER=pulseexpends
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://pulseexpends:CHANGE_ME_STRONG_PASSWORD@localhost:5432/pulseexpends?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- JWT Authentication (RSA keys required in production) ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=20m
JWT_ISSUER=pulseexpends

# --- Statement Encryption (required) ---
STATEMENT_PASSWORD_KEY=CHANGE_ME

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# --- Email (SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@your-domain.com

# --- CORS ---
CORS_ORIGINS=https://your-domain.com

# --- Cookies ---
COOKIE_SECURE=true

# --- Logging ---
LOG_LEVEL=info
