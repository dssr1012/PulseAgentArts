# npm settings (also read by pnpm)
legacy-peer-deps=true

# pnpm-specific: allow build scripts for native dependencies
shamefully-hoist=true
strict-peer-dependencies=false
onlyBuiltDependencies[]=@nestjs/core
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=argon2
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
