// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AuthProvider {
  traditional
  google_sso
  hybrid
}

enum Currency {
  ARS
  USD
  EUR
}

enum CircleRole {
  admin
  member
}

enum InvitationStatus {
  pending
  sent
  accepted
  expired
  delivery_failed
}

enum TransactionType {
  expense
  income
}

enum TransactionSource {
  manual
  statement
  notification_capture
  mcp
  whatsapp
  recurring
}

enum ConfirmationStatus {
  confirmed
  pending_confirmation
}

enum RecurringFrequency {
  weekly
  monthly
  yearly
}

enum CardType {
  Visa
  Mastercard
  AmericanExpress
}

enum PaymentMethod {
  cash
  card
}

enum CardMode {
  debit
  credit
}

enum AlertType {
  amount_discrepancy
  orphaned_duplicate
}

enum Severity {
  alert
  critical
}

enum AlertStatus {
  open
  resolved
}

enum ResolutionAction {
  associated
  edited
  discarded
}

enum PlanStatus {
  active
  completed
  archived
}

enum PlanItemType {
  card_payment
  recurring_expense
  custom
}

enum CardPaymentSource {
  manual
  whatsapp
  mcp
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?   @map("password_hash")
  givenName            String    @map("given_name")
  pictureUrl           String?   @map("picture_url")
  authProvider         AuthProvider @default(traditional) @map("auth_provider")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  whatsappPhone        String?   @map("whatsapp_phone")
  whatsappDefaultCategoryId String? @map("whatsapp_default_category_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  circleMemberships    FamilyGroupMember[]
  transactions         Transaction[]
  recurringTransactions RecurringTransaction[]
  refreshTokens        RefreshToken[]
  whatsappGroups       WhatsappGroup[]
  cardPayments         CardPayment[]

  @@map("users")
}

model WhatsappGroup {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  groupJid  String   @map("group_jid")
  groupName String?  @map("group_name")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupJid])
  @@map("whatsapp_groups")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// FAMILY GROUPS
// ============================================================

model FamilyGroup {
  id           String   @id @default(uuid())
  name         String
  adminUserId  String   @map("admin_user_id")
  baseCurrency Currency @default(ARS) @map("base_currency")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members      FamilyGroupMember[]
  invitations  Invitation[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  categories   Category[]
  creditCards  CreditCard[]
  anomalyAlerts AnomalyAlert[]
  paymentPlans PaymentPlan[]
  projectionSnapshots ProjectionSnapshot[]
  cardPayments     CardPayment[]

  @@index([adminUserId])
  @@map("family_groups")
}

model FamilyGroupMember {
  groupId  String    @map("group_id")
  userId   String    @map("user_id")
  role     CircleRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group    FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([groupId])
  @@map("family_group_members")
}

model Invitation {
  id         String           @id @default(uuid())
  groupId    String           @map("group_id")
  tokenHash  String           @map("token_hash")
  email      String
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  status     InvitationStatus @default(pending)
  createdAt  DateTime         @default(now()) @map("created_at")

  group      FamilyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([groupId])
  @@index([expiresAt])
  @@map("invitations")
}

// ============================================================
// TRANSACTIONS & CATEGORIES
// ============================================================

model Transaction {
  id                 String             @id @default(uuid())
  groupId            String             @map("group_id")
  userId             String             @map("user_id")
  type               TransactionType
  amount             Decimal            @db.Decimal(12, 2)
  currency           Currency
  categoryId         String             @map("category_id")
  description        String?
  merchantName       String?            @map("merchant_name")
  isPrivate          Boolean            @default(false) @map("is_private")
  hiddenUntil        DateTime?          @map("hidden_until")
  source             TransactionSource  @default(manual)
  confirmationStatus ConfirmationStatus @default(confirmed) @map("confirmation_status")
  transactionDate    DateTime           @map("transaction_date")
  paymentMethod      PaymentMethod      @default(cash) @map("payment_method")
  cardId             String?            @map("card_id")
  recurringTransactionId String?        @map("recurring_transaction_id")
  installmentNumber  Int?               @map("installment_number")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  group              FamilyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: SetNull)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  card               CreditCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  anomalyAlerts      AnomalyAlert[]
  matchedStatementItems StatementItem[]

  @@index([groupId, transactionDate])
  @@index([userId])
  @@index([groupId, categoryId])
  @@index([isPrivate])
  @@index([cardId])
  @@index([recurringTransactionId])
  @@map("transactions")
}

model Category {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  name      String
  icon      String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  group     FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("categories")
}

// ============================================================
// RECURRING TRANSACTIONS (automatic debits & installments)
// ============================================================

model RecurringTransaction {
  id                String   @id @default(uuid())
  groupId           String   @map("group_id")
  userId            String   @map("user_id")
  type              TransactionType

  description       String?
  merchantName      String?  @map("merchant_name")
  amount            Decimal  @db.Decimal(12, 2)
  currency          Currency
  categoryId        String   @map("category_id")
  paymentMethod     PaymentMethod @default(cash) @map("payment_method")
  cardId            String?  @map("card_id")

  frequency         RecurringFrequency
  interval          Int      @default(1)
  dayOfMonth        Int?

  startDate         DateTime @map("start_date")
  endDate           DateTime? @map("end_date")
  nextExecutionDate DateTime? @map("next_execution_date")
  lastExecutionDate DateTime? @map("last_execution_date")
  isActive          Boolean  @default(true) @map("is_active")

  totalInstallments   Int?     @map("total_installments")
  currentInstallment  Int?     @map("current_installment")
  originalAmount      Decimal? @db.Decimal(12, 2) @map("original_amount")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  group          FamilyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  card           CreditCard?  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@index([groupId])
  @@index([nextExecutionDate])
  @@index([userId])
  @@map("recurring_transactions")
}

// ============================================================
// CREDIT CARDS & STATEMENTS
// ============================================================

model CreditCard {
  id                String   @id @default(uuid())
  groupId           String   @map("group_id")
  bankName          String   @map("bank_name")
  cardType          CardType @map("card_type")
  cardMode          CardMode @default(debit) @map("card_mode")
  lastFourDigits    String   @map("last_four_digits") @db.Char(4)
  statementPassword String?  @map("statement_password")
  tag               String?

  // Card metadata — auto-populated from statement PDFs
  creditLimit       Decimal? @map("credit_limit") @db.Decimal(12, 2)
  financingRate     Decimal? @map("financing_rate") @db.Decimal(10, 2)  // Annual TNA %
  closingDay        Int?     @map("closing_day")    // Statement closing day of month (1-31)
  dueDay            Int?     @map("due_day")        // Payment due day of month (1-31)

  createdAt         DateTime @default(now()) @map("created_at")

  group          FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  statements     CardStatement[]
  transactions   Transaction[]
  recurringTransactions RecurringTransaction[]
  cardPayments   CardPayment[]

  @@index([groupId])
  @@map("credit_cards")
}

model CardStatement {
  id          String   @id @default(uuid())
  cardId      String   @map("card_id")
  closeDate   DateTime @map("close_date")
  dueDate     DateTime @map("due_date")
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  minPayment  Decimal  @map("min_payment") @db.Decimal(12, 2)
  currency    Currency
  isConfirmed Boolean  @default(false) @map("is_confirmed")
  filePath    String?  @map("file_path")
  createdAt   DateTime @default(now()) @map("created_at")

  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items       StatementItem[]
  cardPayments CardPayment[]

  @@index([cardId])
  @@map("card_statements")
}

model StatementItem {
  id                   String    @id @default(uuid())
  statementId          String    @map("statement_id")
  date                 DateTime
  description          String
  amount               Decimal   @db.Decimal(12, 2)
  currency             Currency
  matchedTransactionId String?   @map("matched_transaction_id")
  installmentNumber    Int?      @map("installment_number")
  totalInstallments    Int?      @map("total_installments")

  statement            CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedTransaction   Transaction?  @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  anomalyAlerts        AnomalyAlert[]

  @@index([statementId])
  @@index([matchedTransactionId])
  @@map("statement_items")
}

// ============================================================
// CARD PAYMENTS (settlements — paying the credit card bill)
// ============================================================

model CardPayment {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  userId      String   @map("user_id")
  cardId      String   @map("card_id")
  amount      Decimal  @db.Decimal(12, 2)
  currency    Currency
  paymentDate DateTime @map("payment_date")
  statementId String?  @map("statement_id")
  source      CardPaymentSource @default(manual)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  group       FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: SetNull)
  card        CreditCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  statement   CardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([groupId, paymentDate])
  @@index([cardId])
  @@index([userId])
  @@map("card_payments")
}

// ============================================================
// ANOMALY ALERTS
// ============================================================

model AnomalyAlert {
  id               String          @id @default(uuid())
  groupId          String          @map("group_id")
  transactionId    String?         @map("transaction_id")
  statementItemId String?         @map("statement_item_id")
  alertType        AlertType       @map("alert_type")
  severity         Severity
  status           AlertStatus     @default(open)
  resolutionAction ResolutionAction? @map("resolution_action")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  group            FamilyGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transaction      Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  statementItem    StatementItem?  @relation(fields: [statementItemId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([transactionId])
  @@index([severity])
  @@map("anomaly_alerts")
}

// ============================================================
// EXCHANGE RATES
// ============================================================

model ExchangeRate {
  baseCurrency   String  @map("base_currency")
  targetCurrency String  @map("target_currency")
  rate           Decimal @db.Decimal(12, 6)
  fetchedAt      DateTime @map("fetched_at")

  @@id([baseCurrency, targetCurrency])
  @@map("exchange_rates")
}

// ============================================================
// NOTIFICATION PATTERNS
// ============================================================

model NotificationPattern {
  id             String   @id @default(uuid())
  appName        String   @map("app_name")
  regexPattern   String   @map("regex_pattern")
  version        Int
  fieldsExtracted String  @map("fields_extracted") // JSON array stored as string
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([version])
  @@index([appName, version])
  @@map("notification_patterns")
}

// ============================================================
// PAYMENT PLANS & PROJECTION SNAPSHOTS
// ============================================================

model PaymentPlan {
  id              String    @id @default(uuid())
  groupId         String    @map("group_id")
  month           String    // YYYY-MM
  scenario        String    // e.g. "Avalanche", "Snowball"
  availableCash   Decimal   @db.Decimal(12, 2) @map("available_cash")
  totalPlanned    Decimal   @db.Decimal(12, 2) @map("total_planned")
  totalPaid       Decimal   @default(0) @db.Decimal(12, 2) @map("total_paid")
  status              PlanStatus @default(active)
  notes               String?
  llmReasoning        String?  @map("llm_reasoning")
  deviationAnalysis   String?  @map("deviation_analysis")
  deviationAnalyzedAt DateTime? @map("deviation_analyzed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  group           FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items           PaymentPlanItem[]

  @@unique([groupId, month])
  @@index([groupId])
  @@map("payment_plans")
}

model PaymentPlanItem {
  id              String       @id @default(uuid())
  planId          String       @map("plan_id")
  itemType        PlanItemType @default(card_payment) @map("item_type")
  cardId          String?      @map("card_id")
  recurringId     String?      @map("recurring_id")
  label           String
  plannedAmount   Decimal      @db.Decimal(12, 2) @map("planned_amount")
  actualAmount    Decimal?     @db.Decimal(12, 2) @map("actual_amount")
  dueDate         DateTime?    @map("due_date")
  dueDay          Int?         @map("due_day")
  isFullPayment   Boolean      @default(false) @map("is_full_payment")
  isPaid          Boolean      @default(false) @map("is_paid")
  paidAt          DateTime?    @map("paid_at")
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  plan            PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("payment_plan_items")
}

model ProjectionSnapshot {
  id              String   @id @default(uuid())
  groupId         String   @map("group_id")
  month           String   // YYYY-MM
  data            Json
  createdAt       DateTime @default(now()) @map("created_at")

  group           FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, month])
  @@map("projection_snapshots")
}