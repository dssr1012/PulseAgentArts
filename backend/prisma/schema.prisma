// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AuthProvider {
  traditional
  google_sso
  hybrid
}

enum Currency {
  ARS
  USD
  EUR
}

enum CircleRole {
  admin
  member
}

enum InvitationStatus {
  pending
  sent
  accepted
  expired
  delivery_failed
}

enum TransactionType {
  expense
  income
}

enum TransactionSource {
  manual
  statement
  notification_capture
  mcp
}

enum ConfirmationStatus {
  confirmed
  pending_confirmation
}

enum CardType {
  Visa
  Mastercard
}

enum AlertType {
  amount_discrepancy
  orphaned_duplicate
}

enum Severity {
  alert
  critical
}

enum AlertStatus {
  open
  resolved
}

enum ResolutionAction {
  associated
  edited
  discarded
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?   @map("password_hash")
  givenName            String    @map("given_name")
  pictureUrl           String?   @map("picture_url")
  authProvider         AuthProvider @default(traditional) @map("auth_provider")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  circleMembership     FamilyGroupMember?
  transactions         Transaction[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// FAMILY GROUPS
// ============================================================

model FamilyGroup {
  id           String   @id @default(uuid())
  name         String
  adminUserId  String   @map("admin_user_id")
  baseCurrency Currency @default(ARS) @map("base_currency")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members      FamilyGroupMember[]
  invitations  Invitation[]
  transactions Transaction[]
  categories   Category[]
  creditCards  CreditCard[]
  anomalyAlerts AnomalyAlert[]

  @@index([adminUserId])
  @@map("family_groups")
}

model FamilyGroupMember {
  groupId  String    @map("group_id")
  userId   String    @map("user_id") @unique
  role     CircleRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group    FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([groupId])
  @@map("family_group_members")
}

model Invitation {
  id         String           @id @default(uuid())
  groupId    String           @map("group_id")
  tokenHash  String           @map("token_hash")
  email      String
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  status     InvitationStatus @default(pending)
  createdAt  DateTime         @default(now()) @map("created_at")

  group      FamilyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([groupId])
  @@index([expiresAt])
  @@map("invitations")
}

// ============================================================
// TRANSACTIONS & CATEGORIES
// ============================================================

model Transaction {
  id                 String             @id @default(uuid())
  groupId            String             @map("group_id")
  userId             String             @map("user_id")
  type               TransactionType
  amount             Decimal            @db.Decimal(12, 2)
  currency           Currency
  categoryId         String             @map("category_id")
  description        String?
  merchantName       String?            @map("merchant_name")
  isPrivate          Boolean            @default(false) @map("is_private")
  hiddenUntil        DateTime?          @map("hidden_until")
  source             TransactionSource  @default(manual)
  confirmationStatus ConfirmationStatus @default(confirmed) @map("confirmation_status")
  transactionDate    DateTime           @map("transaction_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  group              FamilyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: SetNull)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  anomalyAlert       AnomalyAlert?
  matchedStatementItems StatementItem[]

  @@index([groupId, transactionDate])
  @@index([userId])
  @@index([groupId, categoryId])
  @@index([isPrivate])
  @@map("transactions")
}

model Category {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  name      String
  icon      String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  group     FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("categories")
}

// ============================================================
// CREDIT CARDS & STATEMENTS
// ============================================================

model CreditCard {
  id             String   @id @default(uuid())
  groupId        String   @map("group_id")
  bankName       String   @map("bank_name")
  cardType       CardType @map("card_type")
  lastFourDigits String   @map("last_four_digits") @db.Char(4)
  createdAt      DateTime @default(now()) @map("created_at")

  group          FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  statements     CardStatement[]

  @@index([groupId])
  @@map("credit_cards")
}

model CardStatement {
  id          String   @id @default(uuid())
  cardId      String   @map("card_id")
  closeDate   DateTime @map("close_date")
  dueDate     DateTime @map("due_date")
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  minPayment  Decimal  @map("min_payment") @db.Decimal(12, 2)
  currency    Currency
  isConfirmed Boolean  @default(false) @map("is_confirmed")
  filePath    String?  @map("file_path")
  createdAt   DateTime @default(now()) @map("created_at")

  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items       StatementItem[]

  @@index([cardId])
  @@map("card_statements")
}

model StatementItem {
  id                   String    @id @default(uuid())
  statementId          String    @map("statement_id")
  date                 DateTime
  description          String
  amount               Decimal   @db.Decimal(12, 2)
  currency             Currency
  matchedTransactionId String?   @map("matched_transaction_id")

  statement            CardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedTransaction   Transaction?  @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)

  @@index([statementId])
  @@index([matchedTransactionId])
  @@map("statement_items")
}

// ============================================================
// ANOMALY ALERTS
// ============================================================

model AnomalyAlert {
  id               String          @id @default(uuid())
  groupId          String          @map("group_id")
  transactionId    String?         @map("transaction_id")
  statementItemId String?         @map("statement_item_id")
  alertType        AlertType       @map("alert_type")
  severity         Severity
  status           AlertStatus     @default(open)
  resolutionAction ResolutionAction? @map("resolution_action")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  group            FamilyGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transaction      Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  statementItem    StatementItem?  @relation(fields: [statementItemId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([transactionId])
  @@index([severity])
  @@map("anomaly_alerts")
}

// ============================================================
// EXCHANGE RATES
// ============================================================

model ExchangeRate {
  baseCurrency   String  @map("base_currency")
  targetCurrency String  @map("target_currency")
  rate           Decimal @db.Decimal(12, 6)
  fetchedAt      DateTime @map("fetched_at")

  @@id([baseCurrency, targetCurrency])
  @@map("exchange_rates")
}

// ============================================================
// NOTIFICATION PATTERNS
// ============================================================

model NotificationPattern {
  id             String   @id @default(uuid())
  appName        String   @map("app_name")
  regexPattern   String   @map("regex_pattern")
  version        Int
  fieldsExtracted String  @map("fields_extracted") // JSON array stored as string
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([version])
  @@index([appName, version])
  @@map("notification_patterns")
}