# =============================================================================
# PulseExpends - Environment Configuration
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseexpends
POSTGRES_USER=pulseexpends
POSTGRES_PASSWORD=pulseexpends_dev
DATABASE_URL=postgresql://pulseexpends:pulseexpends_dev@localhost:5432/pulseexpends?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=7d
JWT_ISSUER=pulseexpends

# --- Password Hashing ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Account Lockout ---
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# --- Invitation ---
INVITATION_TTL_HOURS=72
INVITATION_TOKEN_BYTES=16

# --- Exchange Rate ---
FX_API_URL=https://open.er-api.com/v6/latest
FX_API_KEY=
FX_CACHE_TTL_SECONDS=86400
FX_STALE_THRESHOLD_HOURS=24
FX_BASE_CURRENCY=ARS

# --- Statement Parsing ---
STATEMENT_MAX_SIZE_MB=10
STATEMENT_TEMP_DIR=./uploads/statements

# --- Anomaly Detection ---
ANOMALY_ORPHAN_THRESHOLD_DAYS=30

# --- Email (SMTP) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pulseexpends.com

# --- Supported Currencies ---
SUPPORTED_CURRENCIES=ARS,USD,EUR

# --- MCP Server ---
MCP_PORT=3001
MCP_API_BASE_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=debug